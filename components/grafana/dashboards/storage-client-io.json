      "description": "How long writes take as the initiator sees them - the metric that stalls SQLite/WALs. vd* series are truenas-w1's virtio root zvol.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
