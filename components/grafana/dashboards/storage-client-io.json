            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "topk(15, 100 * kubelet_volume_stats_used_bytes / kubelet_volume_stats_capacity_bytes)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "PVC usage % (top 15)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
