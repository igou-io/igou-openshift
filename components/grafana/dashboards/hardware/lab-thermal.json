  "description": "Fleet-wide hardware thermals: OCP nodes (node-exporter hwmon + DCGM GPU), rk8s nodes (federated, cluster=\"rk8s\"), TrueNAS (IPMI sensors, smartctl drive temps, fans), MikroTik gear (mktxp), the Nvidia Shield (adb-exporter), and the upsmonitor Pi.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Hottest temperature sensor per device, across every thermal source in the lab: OCP nodes, rk8s nodes, TrueNAS (IPMI + disks), MikroTik gear, the Shield, and the upsmonitor Pi.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "celsius",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 75
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (instance) (node_hwmon_temp_celsius{job=\"node-exporter\", cluster!=\"rk8s\"})",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (instance) (node_hwmon_temp_celsius{job=\"node-exporter\", cluster=\"rk8s\"} or node_thermal_zone_temp{job=\"node-exporter\", cluster=\"rk8s\"})",
          "legendFormat": "rk8s {{instance}}",
          "range": false,
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max(ipmi_temperature_celsius{instance=\"truenas.igou.systems\"})",
          "legendFormat": "truenas IPMI",
          "range": false,
          "instant": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max(smartctl_device_temperature{instance=\"truenas.igou.systems\", temperature_type=\"current\"})",
          "legendFormat": "truenas disks",
          "range": false,
          "instant": true,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (routerboard_name) ({__name__=~\"mktxp_system_.*temperature.*\"})",
          "legendFormat": "{{routerboard_name}}",
          "range": false,
          "instant": true,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max(adb_thermal_temperature_celsius{job=~\"adb-exporter.*\"})",
