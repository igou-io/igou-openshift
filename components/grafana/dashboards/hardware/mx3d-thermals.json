{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "description": "Hardware thermals and fan telemetry for the mx3d Windows desktop, scraped from OhmGraphite (LibreHardwareMonitor) on :4445. CPU die temperature, package power, and effective clocks are structurally unavailable on the Ryzen 9 7945HX3D (LHM SMU gap) - CPU context comes from load and perflib clocks instead.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Arc B580 GPU core",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ohm_gpuintel_celsius{instance=\"mx3d.igou.systems\",sensor=\"GPU Core\"}",
          "legendFormat": "Arc B580"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Radeon 610M (VR SoC)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ohm_gpuati_celsius{instance=\"mx3d.igou.systems\",sensor=\"GPU VR SoC\"}",
          "legendFormat": "610M VR SoC"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Hottest NVMe",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 60 },
              { "color": "red", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(ohm_hdd_celsius{instance=\"mx3d.igou.systems\",sensor=\"Temperature\"})",
          "legendFormat": "hottest NVMe"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Arc GPU fan (0 = passive)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "fieldConfig": {
        "defaults": {
          "unit": "rotrpm",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ohm_gpuintel_revolutions_per_minute{instance=\"mx3d.igou.systems\"}",
          "legendFormat": "Arc B580 fan"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GPU temperatures",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": { "lineWidth": 2, "fillOpacity": 8, "pointSize": 5, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "Arc B580.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3274D9" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "610M.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FF780A" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ohm_gpuintel_celsius{instance=\"mx3d.igou.systems\"}",
          "legendFormat": "Arc B580 · {{sensor}}"
        },
        {
          "refId": "B",
          "expr": "ohm_gpuati_celsius{instance=\"mx3d.igou.systems\"}",
          "legendFormat": "610M · {{sensor}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "NVMe temperatures",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 80 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*hynix.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#56A64B" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*PNY.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#A352CC" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ohm_hdd_celsius{instance=\"mx3d.igou.systems\",sensor=\"Temperature\"}",
          "legendFormat": "{{hardware}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GPU fan speed",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "fieldConfig": {
        "defaults": {
          "unit": "rotrpm",
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "#3274D9" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ohm_gpuintel_revolutions_per_minute{instance=\"mx3d.igou.systems\"}",
          "legendFormat": "Arc B580 · {{sensor}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GPU power",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "Arc B580.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3274D9" } }]
          },
          {
            "matcher": { "id": "byName", "options": "610M · GPU Core" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FF780A" } }]
          },
          {
            "matcher": { "id": "byName", "options": "610M · GPU SoC" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#F2CC0C" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ohm_gpuintel_watts{instance=\"mx3d.igou.systems\"}",
          "legendFormat": "Arc B580 · {{sensor}}"
        },
        {
          "refId": "B",
          "expr": "ohm_gpuati_watts{instance=\"mx3d.igou.systems\"}",
          "legendFormat": "610M · {{sensor}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU load (thermal context)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "id": 9,
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ohm_cpu_load_percent{instance=\"mx3d.igou.systems\",sensor=\"CPU Total\"}",
          "legendFormat": "CPU total"
        },
        {
          "refId": "B",
          "expr": "max(ohm_gpuintel_load_percent{instance=\"mx3d.igou.systems\",sensor=\"GPU Core\"})",
          "legendFormat": "Arc B580 core"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU clock (perflib, via windows_exporter)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "id": 10,
      "fieldConfig": {
        "defaults": {
          "unit": "hertz",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(windows_cpu_core_frequency{instance=\"mx3d.igou.systems\"}) * 1000000",
          "legendFormat": "avg core"
        },
        {
          "refId": "B",
          "expr": "max(windows_cpu_core_frequency{instance=\"mx3d.igou.systems\"}) * 1000000",
          "legendFormat": "max core"
        }
      ]
    },
    {
      "type": "text",
      "title": "",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 28 },
      "id": 11,
      "options": {
        "mode": "markdown",
        "content": "**Known sensor gaps (hardware limitation, not a scrape problem):** the Ryzen 9 7945HX3D's die temperature (Tctl/Tdie), package/core power, and effective clocks all read 0 - LibreHardwareMonitor's SMU support doesn't cover this mobile part. CPU thermal context comes from load and perflib clocks instead. The Arc B580 fan legitimately reads 0 RPM when idle (semi-passive). No motherboard Super-I/O sensors are exposed on this board."
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["mx3d", "hardware"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "mx3d Thermals & Fans",
  "uid": "mx3d-thermals",
  "version": 1
}
