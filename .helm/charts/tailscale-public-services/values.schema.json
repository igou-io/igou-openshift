{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "services"
  ],
  "properties": {
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "namespace",
          "hostname",
          "tag",
          "selector",
          "ports"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
          },
          "namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
          },
          "hostname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
          },
          "tag": {
            "type": "string",
            "pattern": "^tag:ocp-public-[a-z0-9-]+$"
          },
          "selector": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "allowFromTailscale": {
            "type": "boolean"
          },
          "ports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "port",
                "protocol"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10,
                  "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "targetPort": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 15,
                      "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
                    }
                  ]
                },
                "protocol": {
                  "enum": [
                    "TCP",
                    "UDP"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
