{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proxyTag",
    "services",
    "quota",
    "containerResources"
  ],
  "properties": {
    "proxyTag": {
      "type": "string",
      "pattern": "^tag:ocp-public-[a-z0-9-]+$"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "hostname",
          "selector",
          "ports"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
          },
          "hostname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
          },
          "selector": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "ports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "port",
                "protocol"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10,
                  "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "targetPort": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 15,
                      "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
                    }
                  ]
                },
                "protocol": {
                  "enum": [
                    "TCP",
                    "UDP"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests.cpu",
        "requests.memory",
        "limits.cpu",
        "limits.memory",
        "pods",
        "services",
        "services.loadbalancers",
        "persistentvolumeclaims",
        "requests.storage"
      ],
      "properties": {
        "requests.cpu": {
          "type": "string",
          "minLength": 1
        },
        "requests.memory": {
          "type": "string",
          "minLength": 1
        },
        "limits.cpu": {
          "type": "string",
          "minLength": 1
        },
        "limits.memory": {
          "type": "string",
          "minLength": 1
        },
        "pods": {
          "type": "string",
          "minLength": 1
        },
        "services": {
          "type": "string",
          "minLength": 1
        },
        "services.loadbalancers": {
          "type": "string",
          "minLength": 1
        },
        "persistentvolumeclaims": {
          "type": "string",
          "minLength": 1
        },
        "requests.storage": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "containerResources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultRequest",
        "default"
      ],
      "properties": {
        "defaultRequest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory"
          ],
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1
            },
            "memory": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "default": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory"
          ],
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1
            },
            "memory": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
