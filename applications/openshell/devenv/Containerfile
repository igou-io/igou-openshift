FROM ghcr.io/igou-io/igou-devenv:latest@sha256:8e00b51b1870b87f503050e8e979549798809165fc53955baa2332c2d6b0c71c

USER root
RUN python3 -m venv /opt/agent-proxy \
 && /opt/agent-proxy/bin/pip install --no-cache-dir 'litellm[proxy]==1.102.1'
COPY policy.yaml /etc/openshell/policy.yaml
COPY litellm.yaml /etc/openshell/litellm.yaml
COPY agent-glm /usr/local/bin/agent-glm
RUN chmod 0755 /usr/local/bin/agent-glm \
 && ln -s agent-glm /usr/local/bin/codex-glm \
 && ln -s agent-glm /usr/local/bin/claude-glm
ENV PATH=/home/igou/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV HOME=/sandbox
WORKDIR /sandbox
