#!/usr/bin/env bash
# Translate client protocols locally; OpenShell owns outbound credentials.
set -euo pipefail
case "$(basename "$0")" in
    codex-glm) client=codex ;;
    claude-glm) client=claude ;;
    *) echo 'Use codex-glm or claude-glm.' >&2; exit 2 ;;
esac
: "${OPENAI_API_KEY:?Attach the opencode-go-devenv OpenShell provider}"
export OPENCODE_SESSION_ID="${OPENCODE_SESSION_ID:-$(cat /proc/sys/kernel/random/uuid)}"
export NO_PROXY="${NO_PROXY:+$NO_PROXY,}127.0.0.1,localhost"
export no_proxy="$NO_PROXY"
export LITELLM_LOCAL_MODEL_COST_MAP=True
export LITELLM_TELEMETRY=False
proxy_dir=$(mktemp -d /tmp/agent-proxy.XXXXXX)
proxy_pid=''
cleanup() {
    if [[ -n "$proxy_pid" ]]; then
        kill "$proxy_pid" 2>/dev/null || true
        wait "$proxy_pid" 2>/dev/null || true
    fi
    rm -rf "$proxy_dir"
}
trap cleanup EXIT
proxy_port=$(/opt/agent-proxy/bin/python -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')
/opt/agent-proxy/bin/litellm --config /etc/openshell/litellm.yaml \
    --host 127.0.0.1 --port "$proxy_port" > "$proxy_dir/proxy.log" 2>&1 &
proxy_pid=$!
ready=false
for ((attempt=0; attempt<60; attempt++)); do
    if curl --noproxy '*' -fsS "http://127.0.0.1:$proxy_port/health/liveliness" >/dev/null 2>&1; then
        ready=true
        break
    fi
    if ! kill -0 "$proxy_pid" 2>/dev/null; then
        echo 'Local model adapter exited before becoming ready.' >&2
        exit 1
    fi
    sleep 1
done
if [[ "$ready" != true ]]; then
    echo 'Local model adapter readiness timed out.' >&2
    exit 1
fi
if [[ "$client" == codex ]]; then
    codex -c 'model_provider="opencode_glm"' \
        -c 'web_search="disabled"' \
        -c 'model_providers.opencode_glm.name="OpenCode GLM via local adapter"' \
        -c "model_providers.opencode_glm.base_url=\"http://127.0.0.1:$proxy_port/v1\"" \
        -c 'model_providers.opencode_glm.env_key="OPENAI_API_KEY"' \
        -c 'model_providers.opencode_glm.wire_api="responses"' \
        --model glm-5.3-flash "$@"
else
    export ANTHROPIC_BASE_URL="http://127.0.0.1:$proxy_port"
    export ANTHROPIC_AUTH_TOKEN=local-adapter
    export ANTHROPIC_DEFAULT_HAIKU_MODEL=glm-5.3-flash
    export ANTHROPIC_DEFAULT_SONNET_MODEL=glm-5.3-flash
    export ANTHROPIC_DEFAULT_OPUS_MODEL=glm-5.3-flash
    export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
    claude --model glm-5.3-flash "$@"
fi
