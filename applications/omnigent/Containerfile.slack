FROM ghcr.io/omnigent-ai/omnigent-server-kubernetes@sha256:ed3ae35d30572dcd929ba4e1edefdcec53ef178ab2f8147d11a8f2f33dded123

# v0.15.0 publishes the integration source but not a matching PyPI package.
ADD --checksum=sha256:b60890516bea9d65ec54599e58e086ecb20862f24a409000ebc64d6152047d6e \
    https://codeload.github.com/omnigent-ai/omnigent/tar.gz/refs/tags/v0.15.0 \
    /tmp/omnigent-v0.15.0.tar.gz

RUN tar -xzf /tmp/omnigent-v0.15.0.tar.gz -C /tmp \
 && /opt/venv/bin/pip install --no-cache-dir /tmp/omnigent-0.15.0/integrations/slack \
 && /opt/venv/bin/python -c 'import omnigent_slack, slack_bolt' \
 && rm -rf /tmp/omnigent-0.15.0 /tmp/omnigent-v0.15.0.tar.gz

CMD ["omni", "integration", "slack"]
