FROM ghcr.io/omnigent-ai/omnigent-server-kubernetes@sha256:ba384bba57cb1f80b28e3cbfab7c58d6ad94f5cd99c3773a86a1987ffe3bf902

# Keep the Kubernetes provider and add the SDK matching the deployed gateway.
RUN /opt/venv/bin/pip install --no-cache-dir 'openshell==0.0.116'

COPY patch_openshell_service_auth.py /tmp/patch_openshell_service_auth.py
RUN /opt/venv/bin/python /tmp/patch_openshell_service_auth.py \
 && rm /tmp/patch_openshell_service_auth.py

COPY patch_openshell_policy.py /tmp/patch_openshell_policy.py
RUN /opt/venv/bin/python /tmp/patch_openshell_policy.py \
 && rm /tmp/patch_openshell_policy.py
