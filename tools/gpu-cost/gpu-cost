#!/usr/bin/env python3
"""gpu-cost — what the casval GPUs cost in electricity over a time span.

Reads the MEASURED per-GPU energy counter (DCGM_FI_DEV_TOTAL_ENERGY_CONSUMPTION,
millijoules) from thanos-querier and prices it at Dominion Energy VA Schedule 1
(zip 23236) marginal >800 kWh rates including all per-kWh riders (filings
effective 2026-07-01). The window is split on calendar-month boundaries
(America/New_York) so summer (Jun-Sep) and winter (Oct-May) rates each apply
to the energy actually drawn in those months.

Usage:
  gpu-cost                # last 24h
  gpu-cost 7d             # duration: <n>h / <n>d / <n>w
  gpu-cost --from 2026-08-15 --to 2026-08-18
  gpu-cost 30d --json

Auth: needs KUBECONFIG pointing at ocp (oc mints a prometheus-k8s token).
Rates: override with --summer-rate/--winter-rate ($/kWh).

Caveats: the counter resets when casval reboots (scale-from-zero);
increase() treats resets as restarts-from-zero, so energy drawn between the
last scrape before shutdown and the shutdown itself is lost — negligible for
session accounting. Attribution namespace is whatever workload held the GPU
at each sample.
"""

import argparse
import json
import ssl
import subprocess
import sys
import urllib.parse
import urllib.request
from datetime import datetime, timedelta
from zoneinfo import ZoneInfo

THANOS = "https://thanos-querier-openshift-monitoring.apps.ocp.igou.systems"
TZ = ZoneInfo("America/New_York")
SUMMER_MONTHS = {6, 7, 8, 9}
DEFAULT_SUMMER = 0.14834  # $/kWh, Dominion VA Sch.1 >800 kWh + all riders, eff. 2026-07-01
DEFAULT_WINTER = 0.12907
MJ_PER_KWH = 3.6e9


def parse_duration(s):
    units = {"h": 3600, "d": 86400, "w": 604800}
    if s and s[-1] in units and s[:-1].isdigit():
        return int(s[:-1]) * units[s[-1]]
    raise argparse.ArgumentTypeError(f"bad duration {s!r} (use e.g. 24h, 7d, 2w)")


def parse_when(s):
    for fmt in ("%Y-%m-%d %H:%M", "%Y-%m-%dT%H:%M", "%Y-%m-%d"):
        try:
            return datetime.strptime(s, fmt).replace(tzinfo=TZ)
        except ValueError:
            continue
    raise argparse.ArgumentTypeError(f"bad timestamp {s!r} (use YYYY-MM-DD [HH:MM])")


def month_buckets(start, end):
    """Yield (bucket_start, bucket_end) split on calendar-month boundaries."""
    cur = start
    while cur < end:
        nxt = (cur.replace(day=1, hour=0, minute=0, second=0, microsecond=0)
               + timedelta(days=32)).replace(day=1)
        yield cur, min(nxt, end)
        cur = min(nxt, end)


def mint_token():
    for cmd in (["oc", "create", "token", "prometheus-k8s", "-n", "openshift-monitoring"],
                ["oc", "whoami", "-t"]):
        r = subprocess.run(cmd, capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    sys.exit("error: could not mint a token via oc — is KUBECONFIG set to ocp?")


def query(token, expr, at):
    data = urllib.parse.urlencode({"query": expr, "time": str(at.timestamp())}).encode()
    req = urllib.request.Request(f"{THANOS}/api/v1/query", data=data,
                                 headers={"Authorization": f"Bearer {token}"})
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE  # lab route
    with urllib.request.urlopen(req, context=ctx, timeout=30) as resp:
        body = json.load(resp)
    if body["status"] != "success":
        sys.exit(f"error: thanos query failed: {body}")
    return body["data"]["result"]


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("duration", nargs="?", type=parse_duration,
                    help="lookback window, e.g. 24h / 7d / 2w (default 24h)")
    ap.add_argument("--from", dest="t_from", type=parse_when, help="start (local time)")
    ap.add_argument("--to", dest="t_to", type=parse_when, help="end (local, default now)")
    ap.add_argument("--summer-rate", type=float, default=DEFAULT_SUMMER)
    ap.add_argument("--winter-rate", type=float, default=DEFAULT_WINTER)
    ap.add_argument("--json", action="store_true", dest="as_json")
    args = ap.parse_args()

    end = args.t_to or datetime.now(TZ)
    if args.t_from:
        start = args.t_from
    else:
        start = end - timedelta(seconds=args.duration or 86400)
    if start >= end:
        sys.exit("error: start must be before end")

    token = mint_token()
    rows = {}   # (gpu, model, namespace) -> {kwh, usd}
    for b_start, b_end in month_buckets(start, end):
        rate = args.summer_rate if b_start.month in SUMMER_MONTHS else args.winter_rate
        secs = int((b_end - b_start).total_seconds())
        expr = (f"sum by (gpu, modelName, exported_namespace) "
                f"(increase(DCGM_FI_DEV_TOTAL_ENERGY_CONSUMPTION[{secs}s]))")
        for s in query(token, expr, b_end):
            m = s["metric"]
            key = (m.get("gpu", "?"), m.get("modelName", "?"),
                   m.get("exported_namespace", "(idle/unattributed)"))
            kwh = float(s["value"][1]) / MJ_PER_KWH
            r = rows.setdefault(key, {"kwh": 0.0, "usd": 0.0})
            r["kwh"] += kwh
            r["usd"] += kwh * rate

    hours = (end - start).total_seconds() / 3600
    total_kwh = sum(r["kwh"] for r in rows.values())
    total_usd = sum(r["usd"] for r in rows.values())

    if args.as_json:
        print(json.dumps({
            "from": start.isoformat(), "to": end.isoformat(),
            "rates": {"summer": args.summer_rate, "winter": args.winter_rate},
            "gpus": [{"gpu": g, "model": mo, "namespace": ns,
                      "kwh": round(r["kwh"], 4), "usd": round(r["usd"], 4)}
                     for (g, mo, ns), r in sorted(rows.items())],
            "total": {"kwh": round(total_kwh, 4), "usd": round(total_usd, 4),
                      "avg_watts": round(total_kwh * 1000 / hours, 1)},
        }, indent=2))
        return

    print(f"GPU energy cost  {start:%Y-%m-%d %H:%M} -> {end:%Y-%m-%d %H:%M}  ({hours:.1f} h)")
    print(f"rates $/kWh: summer(Jun-Sep) {args.summer_rate}  winter(Oct-May) {args.winter_rate}\n")
    if not rows:
        print("no GPU energy samples in this window (casval scaled down the whole time?)")
        return
    w = max(len(ns) for (_, _, ns) in rows)
    print(f"{'GPU':<4} {'model':<26} {'workload ns':<{w}} {'kWh':>8} {'USD':>8}")
    for (g, mo, ns), r in sorted(rows.items()):
        print(f"{g:<4} {mo:<26} {ns:<{w}} {r['kwh']:>8.3f} {r['usd']:>8.2f}")
    print("-" * (4 + 1 + 26 + 1 + w + 18))
    print(f"{'total':<{4 + 1 + 26 + 1 + w}} {total_kwh:>8.3f} {total_usd:>8.2f}"
          f"   (avg {total_kwh * 1000 / hours:.0f} W)")


if __name__ == "__main__":
    main()
